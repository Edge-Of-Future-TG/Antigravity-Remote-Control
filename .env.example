# Antigravity Remote Control v6.0 Configuration

# Password for Web / Internet Tunnel access (and x-ag-key / Magic QR bootstrap)
# Leave unset or change before exposing via any public tunnel.
APP_PASSWORD=change-me-strong-password

# Primary Tunnel Provider: cloudflare, pinggy, serveo, or ngrok
# - cloudflare (default): Zero-account HTTPS tunnel (*.trycloudflare.com). Automatically
#   uses DoH edge resolution + payload health verification and falls back through
#   pinggy -> serveo -> localtunnel if port 7844 is blocked/throttled by VPN or ISP.
# - pinggy: Fast SSH-over-443 tunnel (recommended behind restrictive ISPs or VPNs).
# - serveo: SSH-over-443 tunnel via serveo.net (requires OpenSSH client in PATH).
# - ngrok: Uses pyngrok (requires NGROK_AUTHTOKEN below).
TUNNEL_PROVIDER=cloudflare

# Server Listening Port (Dual HTTP/WS + HTTPS/WSS multiplexer)
PORT=3000

# Optional: Pin specific LAN IPv4 address for local Wi-Fi QR & URL display
# Useful if a VPN virtual adapter takes priority over your Wi-Fi IP.
# HOST_IP=192.168.1.50

# Cloudflare Persistent Tunnel (Optional)
# CLOUDFLARE_TUNNEL_NAME=your-tunnel-name
# CLOUDFLARE_TUNNEL_URL=https://your-custom-domain.com

# Pinggy Options (Optional - for custom/persistent subdomain)
# PINGGY_TOKEN=your-pinggy-token
# PINGGY_SERVER=a.pinggy.io:443

# ngrok Authtoken (Required only when TUNNEL_PROVIDER=ngrok)
# Get a free token at https://dashboard.ngrok.com
# NGROK_AUTHTOKEN=your-ngrok-authtoken

# Security Overrides (Optional - changing either invalidates existing cookies)
# SESSION_SECRET=your-random-session-secret-here
# AUTH_SALT=your-random-auth-salt-here
